# Existing .gitignore content
*

# Exclude these from being ignored
!.gitignore
!murosync_poc_v1.xpr
!murosync_poc_platform.xsa
!/murosync_poc_v1.srcs/
!/murosync_poc_v1.srcs/**

# Add the specific .bit file from a path relative to the .gitignore location
!/murosync_poc_v1.runs/
!/murosync_poc_v1.runs/impl_1/
!/murosync_poc_v1.runs/impl_1/murosync_poc_top.bit

# Build automation scripts — only .tcl and .bat files (no Vivado logs/junk)
!/scripts/
!/scripts/*.tcl
!/scripts/*.bat

# Built bitstreams and Vitis hardware platforms (named per MODE)
# Generated by scripts/build_bitstream.tcl
!/bitstreams/
!/bitstreams/**